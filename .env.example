# Copy to .env on Ubuntu, then replace the password. Never commit .env.
# Fixed project/volume: perfume-dev / perfume-dev_pgdata; do not rename them.
# This deployment is independent of stock-dividend; never copy the stock project's .env.
COMPOSE_PROJECT_NAME=perfume-dev
DB_NAME=perfume
DB_USERNAME=perfume_user
DB_PASSWORD='replace-with-a-long-random-password'

# DB_URL is generated by compose.yaml using db:5432.
# Do not copy the Windows localhost DB_URL into the containers.
# Ubuntu host access: 127.0.0.1:15432 (SSH tunnel required from Windows).
# Eclipse/DBeaver tunnel setup: docs/docker-compose-deployment.md.
# Do not add SCENTREV_API_KEY or enable import/live-test flags for web deployment.

# Optional AI APIs for a private development LAN. Authentication is staged separately below.
# Read docs/perfume-ai-lan-activation.md before enabling. Never replace an existing .env.
# Obtain each full model digest from the existing Ollama /api/tags; no real digest in Git.
PERFUME_AI_SEARCH_ENABLED=false
PERFUME_AI_SEARCH_MODEL_DIGEST=
PERFUME_AI_RECOMMEND_ENABLED=false
PERFUME_AI_RECOMMEND_MODEL_DIGEST=

# Prepare docs/sql/auth-schema.sql and the console bootstrap before enabling.
# Secure cookies are the default. Private Ubuntu HTTP exception: docs/auth-ubuntu-development.md.
# No default password or bootstrap token belongs here.
PERFUME_AUTH_ENABLED=false
PERFUME_AUTH_DEV_HTTP_ENABLED=false

# Disabled until support-schema.sql has been applied with separate approval.
# Exact browser origins only, for example http://192.168.0.19:8088 (no wildcard).
PERFUME_SUPPORT_ENABLED=false
PERFUME_SUPPORT_ALLOWED_ORIGINS=
