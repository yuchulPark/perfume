# Allow only Maven build inputs; do not send the database dump or developer secrets.
*
!pom.xml
!mvnw
!.mvn/
!.mvn/**
!src/
!src/**
# Keep the migration test input without admitting other documentation or SQL files.
!docs/
docs/*
!docs/sql/
docs/sql/*
!docs/sql/perfume-embeddings-v1.sql
**/application-local.properties
**/application-secret.properties
**/.env
**/.env.*
**/*.dump
**/*.backup
**/*.log
**/target/
