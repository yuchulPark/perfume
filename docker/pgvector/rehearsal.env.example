# Copy to the ignored repository-root .env.pgvector-rehearsal; chmod 600 it.
# Replace every placeholder using docs/pgvector-rehearsal.md, never the latest tag.
POSTGRES_BASE_IMAGE=postgres:17-bookworm@sha256:REPLACE_WITH_RUNNING_IMAGE_REPO_DIGEST
POSTGRES_SERVER_VERSION=17.REPLACE_WITH_RUNNING_MINOR
POSTGRES_SERVER_VERSION_NUM=REPLACE_WITH_RUNNING_SERVER_VERSION_NUM
# Existing official Bookworm databases normally use UTF8 / en_US.utf8 / libc.
# Confirm the source DB values first; this stage supports matching libc locales.
PGVECTOR_TEST_LOCALE=REPLACE_WITH_SOURCE_LC_COLLATE_AND_LC_CTYPE
# New test-only credential; do not reuse the production password.
PGVECTOR_TEST_PASSWORD=REPLACE_WITH_NEW_RANDOM_TEST_PASSWORD
